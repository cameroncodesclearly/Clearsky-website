---
// Service page, laid out as in the "Our Services" Google Doc (see
// src/content.config.ts). Services with status "building" show the
// "Building in progress" page. The photo carousel (photos tagged with this
// page in Notion) and the sunset footer are added by BaseLayout.
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TitleSun from '../../components/TitleSun.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import WorkCard from '../../components/WorkCard.astro';
import BuildingInProgress from '../../components/BuildingInProgress.astro';
import { publishedServices } from '../../lib/site';

export async function getStaticPaths() {
  const services = await publishedServices();
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const study = async (slug?: string) => (slug ? await getEntry('caseStudies', slug) : undefined);
const rows = await Promise.all(d.rows.map(async (r) => ({ ...r, entry: await study(r.caseStudy) })));
const studies = (await Promise.all(d.caseStudies.map(study))).filter((s) => s && !s.data.draft);
---
<BaseLayout
  title={d.seoTitle || d.title}
  description={d.seoDescription || d.lead || d.rows[0]?.text || `${d.title} from Clear Sky Creations.`}
>
  {d.status === 'building' ? (
    <BuildingInProgress name={d.title} kind="service" />
  ) : (
    <article class="svc">
      <header class="svc-hero container">
        <p class="ui ui-muted">{d.title}</p>
        <div class="rise">
          <TitleSun size="min(30vw, 220px)" />
          <h1 class="mega svc-hero__headline">{d.headline || d.title}</h1>
        </div>
        {d.subheadline && <p class="display svc-hero__sub">{d.subheadline}</p>}
      </header>

      {d.video && (
        <section class="svc-video container" data-reveal>
          <VideoPlayer video={d.video} title={d.title} class="svc-video__frame" sizes="(min-width: 1440px) 1400px, 100vw" />
        </section>
      )}

      {(d.subtitle || d.lead) && (
        <section class="svc-lead narrow" data-reveal>
          {d.subtitle && <p class="display svc-lead__subtitle">{d.subtitle}</p>}
          {d.lead && <p class="statement">{d.lead}</p>}
        </section>
      )}

      {rows.length > 0 && (
        <section class="svc-rows container">
          {rows.map((r, i) => (
            <div class:list={['svc-row', { 'is-flipped': i % 2 === 1 }]}>
              <p class="statement svc-row__text" data-reveal>{r.text}</p>
              {r.entry && (
                <div class="svc-row__study" data-reveal>
                  <WorkCard entry={r.entry} ratio="16x10" sizes="(min-width: 900px) 45vw, 100vw" />
                </div>
              )}
            </div>
          ))}
        </section>
      )}

      {d.included.length > 0 && (
        <section class="svc-included container" aria-label="What's included">
          <ul>{d.included.map((item) => <li class="mega" data-reveal>{item}</li>)}</ul>
        </section>
      )}

      {d.stat && <p class="statement svc-stat narrow" data-reveal>{d.stat}</p>}

      {(d.packages.length > 0 || d.customQuote) && (
        <section class="svc-packages container" aria-label="Packages">
          {d.packages.length > 0 && d.packagesIntro && <p class="statement svc-packages__intro" data-reveal>{d.packagesIntro}</p>}
          {d.packages.length > 0 && (
            <div class="svc-packages__grid">
              {d.packages.map((p) => (
                <div class:list={['svc-package', { 'is-featured': p.badge }]} data-reveal>
                  {p.badge && <p class="ui svc-package__badge">★ {p.badge}</p>}
                  <h3 class="display">{p.name}</h3>
                  {p.price && <p class="svc-package__price">{p.price}</p>}
                  {p.monthly && <p class="ui svc-package__monthly">{p.monthly}</p>}
                  {p.priceNote && <p class="ui ui-muted">{p.priceNote}</p>}
                  {p.summary && <p>{p.summary}</p>}
                  {p.includes.length > 0 && <ul>{p.includes.map((x) => <li>{x}</li>)}</ul>}
                  {p.note && <p class="svc-package__note">{p.note}</p>}
                  <a class:list={['pill', { 'pill--solid': p.badge }]} href="/contact/">{p.cta || 'Get started'}</a>
                </div>
              ))}
            </div>
          )}
          {d.customQuote && <a class="pill pill--solid svc-packages__quote" href="/contact/">{d.customQuote}</a>}
          {d.packages.length > 0 && d.packagesFootnote && <p class="svc-packages__footnote">{d.packagesFootnote}</p>}
        </section>
      )}

      {d.steps.length > 0 && (
        <section class="svc-steps container" aria-labelledby="steps-heading">
          <h2 id="steps-heading" class="ui ui-muted">How it works</h2>
          <ol>
            {d.steps.map((s, i) => (
              <li data-reveal>
                <span class="display svc-steps__n">{i + 1}</span>
                <h3 class="display">{s.title}</h3>
                {s.body && <p>{s.body}</p>}
              </li>
            ))}
          </ol>
        </section>
      )}

      {studies.length > 0 && (
        <section class="svc-studies container" aria-labelledby="studies-heading">
          <h2 id="studies-heading" class="ui ui-muted">Case studies</h2>
          <div class="svc-studies__grid">
            {studies.map((s) => <div data-reveal><WorkCard entry={s!} ratio="4x5" sizes="(min-width: 900px) 20vw, 50vw" /></div>)}
          </div>
        </section>
      )}
    </article>
  )}
</BaseLayout>

<style>
  .svc { padding-bottom: clamp(3rem, 6vw, 6rem); }
  .svc > * + * { margin-top: clamp(4rem, 9vw, 9rem); }
  .svc-hero { display: grid; justify-items: center; gap: 1rem; text-align: center; padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem)); }
  .svc-hero__headline { max-width: 12ch; font-size: min(var(--mega), 17svh); }
  .svc-hero__sub { max-width: 22ch; font-size: clamp(1.6rem, 0.9rem + 2.6vw, 3.2rem); line-height: 1; }
  .svc-video :global(.svc-video__frame) { border-radius: var(--radius-lg); }
  .svc-lead { display: grid; gap: 1.2rem; text-align: center; }
  .svc-lead__subtitle { font-size: clamp(1.8rem, 1rem + 3vw, 3.6rem); }

  .svc-rows { display: grid; gap: clamp(4rem, 8vw, 8rem); }
  .svc-row { display: grid; gap: 2rem; align-items: center; }
  .svc-row__text { text-align: center; max-width: 30ch; margin-inline: auto; }
  @media (min-width: 900px) {
    .svc-row { grid-template-columns: 1fr 1fr; gap: clamp(3rem, 6vw, 6rem); }
    .svc-row.is-flipped .svc-row__text { order: 2; }
  }

  .svc-included ul { list-style: none; margin: 0; padding: 0; text-align: center; }
  .svc-included li { font-size: clamp(2.2rem, 1rem + 6.5vw, 7.5rem); line-height: 0.95; }
  .svc-stat { text-align: center; }

  .svc-packages { display: grid; justify-items: center; gap: 2.5rem; text-align: center; }
  .svc-packages__intro { max-width: 26ch; }
  .svc-packages__grid { display: grid; gap: 1.2rem; width: 100%; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); align-items: stretch; }
  .svc-package {
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem; text-align: center;
    padding: clamp(1.6rem, 3vw, 2.4rem); border-radius: var(--radius-lg);
    background: rgba(255, 252, 244, 0.55); backdrop-filter: blur(8px);
  }
  .svc-package.is-featured { background: rgba(255, 252, 244, 0.85); box-shadow: 0 0 0 2px var(--mustard); }
  .svc-package h3 { font-size: clamp(2rem, 1.4rem + 1.6vw, 3rem); }
  .svc-package__badge { color: var(--mustard); }
  .svc-package__price { font-family: var(--font-display); font-size: clamp(2.6rem, 2rem + 1.6vw, 3.6rem); line-height: 1; margin: 0.2rem 0 0; }
  .svc-package ul { list-style: none; margin: 1rem 0; padding: 0; display: grid; gap: 0.55rem; font-size: 0.95rem; }
  .svc-package__note { font-weight: 600; font-size: 0.92rem; }
  .svc-package .pill { margin-top: auto; }
  .svc-packages__footnote { max-width: 62rem; font-size: 0.72rem; line-height: 1.5; opacity: 0.65; }

  .svc-steps { text-align: center; }
  .svc-steps ol { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); }
  .svc-steps__n { display: block; font-size: 3rem; color: var(--mustard); }

  .svc-studies h2 { text-align: center; }
  .svc-studies__grid { display: grid; gap: 1.2rem; margin-top: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 260px)); justify-content: center; }
</style>
