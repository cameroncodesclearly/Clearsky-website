---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseVideo, backgroundEmbed } from '../lib/site';

export interface Slide {
  client: string;
  title: string;
  href: string;
  video?: string | null;
  poster: ImageMetadata;
}
interface Props { slides: Slide[] }
const { slides } = Astro.props;
---
<section class="hero" data-full-bleed data-header-light data-hero aria-label="Featured work">
  <div class="hero__card" data-shrink>
    {slides.map((s, i) => {
      const ref = parseVideo(s.video);
      return (
        <div class:list={['frame hero__slide', { 'is-active': i === 0 }]} data-slide data-src={ref ? backgroundEmbed(ref) : undefined}>
          <Image src={s.poster} alt="" widths={[800, 1280, 1920]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
        </div>
      );
    })}
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__texts">
      {slides.map((s, i) => (
        <a class:list={['hero__text', { 'is-active': i === 0 }]} href={s.href} data-text tabindex={i === 0 ? undefined : -1} aria-hidden={i === 0 ? undefined : 'true'}>
          <span class="hero__client">{s.client}</span>
          <span class="hero__title script">{s.title}</span>
        </a>
      ))}
    </div>
    {slides.length > 1 && (
      <div class="hero__thumbs" role="tablist" aria-label="Choose a project">
        {slides.map((s, i) => (
          <button class:list={['hero__thumb', { 'is-active': i === 0 }]} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${s.client}: ${s.title}`} data-thumb>
            <Image src={s.poster} alt="" widths={[160]} sizes="80px" />
            <span class="hero__progress" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .hero { height: 100svh; min-height: 540px; position: relative; }
  .hero__card {
    --shrink: 0;
    position: relative; height: 100%; overflow: hidden; color: var(--paper); background: var(--ink);
    transform-origin: 50% 0;
    scale: calc(1 - var(--shrink) * 0.1);
    border-radius: calc(var(--shrink) * 64px);
  }
  .hero__slide { position: absolute; inset: 0; border-radius: 0; opacity: 0; transition: opacity 1s var(--ease); background: var(--ink); }
  .hero__slide.is-active { opacity: 1; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(transparent 55%, rgba(26, 19, 7, 0.55)); pointer-events: none; }
  .hero__texts { position: absolute; left: var(--gutter); bottom: var(--gutter); right: var(--gutter); }
  .hero__text {
    position: absolute; left: 0; bottom: 0; display: grid; max-width: 70%;
    opacity: 0; translate: 0 12px; transition: opacity 0.6s var(--ease), translate 0.8s var(--ease); pointer-events: none;
  }
  .hero__text.is-active { position: relative; opacity: 1; translate: 0 0; pointer-events: auto; }
  .hero__client { font-family: var(--font-display); font-size: clamp(2.2rem, 1.4rem + 3vw, 4.4rem); line-height: 0.9; text-transform: uppercase; }
  .hero__title { font-size: clamp(1.8rem, 1.2rem + 2.4vw, 3.6rem); line-height: 1; color: var(--butter); }
  .hero__thumbs { position: absolute; right: var(--gutter); bottom: var(--gutter); display: flex; gap: 0.5rem; }
  .hero__thumb { position: relative; width: clamp(52px, 5vw, 76px); aspect-ratio: 16 / 10; border-radius: 6px; overflow: hidden; opacity: 0.6; outline: 1.5px solid transparent; transition: opacity 0.3s, outline-color 0.3s; }
  .hero__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .hero__thumb.is-active, .hero__thumb:hover { opacity: 1; outline-color: var(--paper); }
  .hero__progress { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--butter); transform: scaleX(0); transform-origin: left; }
  .hero__thumb.is-active .hero__progress { animation: hero-progress var(--hero-dur, 9s) linear forwards; }
  @keyframes hero-progress { to { transform: scaleX(1); } }
  @media (max-width: 699px) {
    .hero__thumbs { flex-direction: column; bottom: auto; top: calc(var(--header-h) + 0.5rem); }
    .hero__text { max-width: 100%; }
  }
</style>

<script>
  import { onPlaying } from '../scripts/player';
  const DURATION = 9000;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const texts = [...hero.querySelectorAll<HTMLElement>('[data-text]')];
    const thumbs = [...hero.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    let current = 0;
    let timer = 0;

    const loadVideo = (slide: HTMLElement) => {
      if (reduce || !slide.dataset.src || slide.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = slide.dataset.src;
      iframe.allow = 'autoplay; fullscreen';
      iframe.tabIndex = -1;
      iframe.setAttribute('aria-hidden', 'true');
      slide.append(iframe);
      onPlaying(iframe, () => slide.classList.add('is-playing'), () => iframe.remove());
    };

    const show = (i: number) => {
      const prev = slides[current];
      current = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === current));
      texts.forEach((t, k) => {
        t.classList.toggle('is-active', k === current);
        t.toggleAttribute('aria-hidden', k !== current);
        t.tabIndex = k === current ? 0 : -1;
      });
      thumbs.forEach((t, k) => {
        t.classList.toggle('is-active', k === current);
        t.setAttribute('aria-selected', String(k === current));
      });
      loadVideo(slides[current]);
      // Drop the previous player after the crossfade so only one video streams.
      if (prev !== slides[current]) setTimeout(() => { prev.querySelector('iframe')?.remove(); prev.classList.remove('is-playing'); }, 1100);
      clearTimeout(timer);
      if (slides.length > 1 && !reduce) timer = window.setTimeout(() => show(current + 1), DURATION);
    };

    hero.style.setProperty('--hero-dur', `${DURATION / 1000}s`);
    thumbs.forEach((t, k) => t.addEventListener('click', () => show(k)));
    show(0);
  });
</script>
