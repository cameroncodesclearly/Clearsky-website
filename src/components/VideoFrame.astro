---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseVideo, backgroundEmbed, posterFor } from '../lib/site';

// A media frame that shows a still and, once it scrolls into view, swaps in a
// muted looping player for the linked video.
interface Props {
  video?: string | null;
  poster?: ImageMetadata | null;
  alt?: string;
  ratio?: '16x9' | '16x10' | '9x16' | '4x5' | '1' | 'free';
  vertical?: boolean;
  cursor?: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
  play?: boolean;
}
const { video, poster, alt = '', ratio = '16x9', vertical, cursor, class: className, sizes = '(min-width: 900px) 50vw, 100vw', eager = false, play = true } = Astro.props;
const ref = parseVideo(video);
const still = poster ?? posterFor(ref);
const isVertical = vertical ?? (still ? still.height > still.width : false);
---
<div
  class:list={['frame', ratio !== 'free' && `ratio-${ratio}`, { 'is-vertical': isVertical }, className]}
  data-embed={ref && play ? backgroundEmbed(ref) : undefined}
  data-cursor={cursor}
>
  {still && (
    <Image src={still} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  )}
  <slot />
</div>
