---
// "Clear Sky" wordmark in yellow with light streaming off the letters like
// wind-blown haze. The letters stay real text; a canvas behind them draws the
// streaks. Each thin band of the letters is smeared downwind by its own,
// ever-changing length, which gives the fibrous, uneven look of light in mist.
// At rest the wind blows left to right (strength from the live wind at a
// clear-sky spot); while scrolling the streaks also trail behind the page.
interface Props { text?: string }
const { text = 'Clear Sky' } = Astro.props;
---
<span class="glow-mark" data-glow-mark>
  <canvas class="glow-mark__mist" aria-hidden="true"></canvas>
  <span class="glow-mark__text">{text}</span>
</span>

<style>
  .glow-mark {
    --glow: #fff2a0;
    position: relative;
    display: inline-block;
    isolation: isolate;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .glow-mark__text {
    position: relative;
    z-index: 1;
    color: var(--glow);
    text-shadow: 0 0 6px rgba(255, 242, 160, 0.55), 0 0 16px rgba(255, 236, 130, 0.3);
    transition: color 0.35s var(--ease);
  }
  .glow-mark__mist {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    filter: blur(0.7px); /* softens the fibres into haze */
  }
  /* Pale yellow vanishes on the off-white pages; mustard stays readable there. */
  :global(.header:not(.is-light)) .glow-mark { --glow: #d9b435; }
  :global(html.theme-blue) .glow-mark, :global(html.theme-ink) .glow-mark { --glow: #fff2a0; }
</style>

<script>
  // Clear-sky spots: Palm Springs, Punta Cana, the Namib, the Sahara, Atacama, Las Vegas.
  const SPOTS: [number, number][] = [[33.8, -116.5], [23.7, -69.5], [-24.6, 15.1], [25.0, 25.3], [-30, -70.8], [36.1, -115.1]];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Room around the letters for the streaks: mostly downwind (right), some above and below.
  const PAD = { left: 6, right: 240, top: 46, bottom: 46 };
  const BAND = 2; // band height in CSS px; thinner bands make finer fibres
  const COPIES = 34; // smear steps per band

  let windSpeed = 12;

  async function liveWind(): Promise<number> {
    try {
      const cached = sessionStorage.getItem('cs-wind');
      if (cached) return JSON.parse(cached).speed;
    } catch {}
    const lat = SPOTS.map((s) => s[0]).join(), lon = SPOTS.map((s) => s[1]).join();
    const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=wind_speed_10m,wind_direction_10m,weather_code,is_day`);
    const all: { current: { wind_speed_10m: number; wind_direction_10m: number; weather_code: number; is_day: number } }[] = await res.json();
    const clear = all.filter((x) => x.current.weather_code === 0 && x.current.is_day);
    const pool = clear.length ? clear : all;
    const c = pool[Math.floor(Math.random() * pool.length)].current;
    try { sessionStorage.setItem('cs-wind', JSON.stringify({ speed: c.wind_speed_10m, dir: c.wind_direction_10m })); } catch {}
    return c.wind_speed_10m;
  }

  // Cheap smooth noise: several out-of-step waves, so nothing visibly repeats.
  const wave = (t: number, seed: number) =>
    0.5 + 0.28 * Math.sin(t * 0.61 + seed * 1.7) + 0.14 * Math.sin(t * 1.43 + seed * 3.1) + 0.08 * Math.sin(t * 3.7 + seed * 5.3);

  document.querySelectorAll<HTMLElement>('[data-glow-mark]').forEach(async (mark) => {
    const canvas = mark.querySelector<HTMLCanvasElement>('.glow-mark__mist')!;
    const label = mark.querySelector<HTMLElement>('.glow-mark__text')!;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    liveWind().then((s) => (windSpeed = s)).catch(() => {});

    const src = document.createElement('canvas'); // the letters, rendered once
    const sctx = src.getContext('2d')!;
    let dpr = 1, textW = 0, textH = 0, color = '';
    let seeds: number[] = [];

    const prepare = () => {
      const cs = getComputedStyle(label);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = label.getBoundingClientRect();
      textW = Math.ceil(rect.width);
      textH = Math.ceil(rect.height);
      color = cs.color;
      src.width = Math.ceil((textW + 8) * dpr);
      src.height = Math.ceil((textH + 8) * dpr);
      sctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      sctx.clearRect(0, 0, src.width, src.height);
      sctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
      (sctx as CanvasRenderingContext2D & { letterSpacing?: string }).letterSpacing = cs.letterSpacing;
      sctx.textBaseline = 'top';
      sctx.fillStyle = color;
      sctx.fillText(label.textContent!.trim().toUpperCase(), 0, (textH - parseFloat(cs.fontSize)) / 2 + 1);

      const w = textW + PAD.left + PAD.right, h = textH + PAD.top + PAD.bottom;
      canvas.width = Math.ceil(w * dpr);
      canvas.height = Math.ceil(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      canvas.style.left = `${-PAD.left}px`;
      canvas.style.top = `${-PAD.top}px`;
      const bands = Math.ceil((textH + 8) / BAND);
      seeds = Array.from({ length: bands }, (_, i) => i * 7.13 + Math.random() * 3);
    };

    let lastY = window.scrollY, scrollV = 0, smear = 0;
    const frame = (now: number) => {
      const t = now / 1000;
      scrollV += (window.scrollY - lastY) * 0.3;
      lastY = window.scrollY;
      scrollV *= 0.9;
      // Scrolling down carries the mark down through the air, so the light is left above it.
      smear += (-Math.max(-60, Math.min(60, scrollV * 2)) - smear) * 0.15;

      if (getComputedStyle(label).color !== color) prepare();
      const light = color !== 'rgb(217, 180, 53)'; // pale yellow over dark: add light
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.setTransform(dpr, 0, 0, dpr, PAD.left * dpr, PAD.top * dpr);
      ctx.globalCompositeOperation = light ? 'lighter' : 'source-over';

      // Overall gust strength, then a separate length and lift for every band.
      const reach = (95 + Math.min(windSpeed, 30) * 5) * (0.55 + 0.6 * wave(t * 0.6, 0.3));
      const mid = seeds.length / 2;
      for (let b = 0; b < seeds.length; b++) {
        const y0 = b * BAND;
        const fibre = wave(t + seeds[b] * 0.21, seeds[b]);
        // A few bands catch a stronger gust: long bright fibres among short ones.
        const len = reach * (0.25 + 1.05 * Math.pow(fibre, 1.6));
        // Upper bands rise and lower bands sink a little, so the light fans out.
        const fan = (b - mid) / mid;
        const slope = -0.07 + fan * 0.06 + 0.025 * Math.sin(t * 0.8 + seeds[b]);
        const strength = (light ? 0.07 : 0.1) + (light ? 0.08 : 0.12) * fibre;
        for (let k = 1; k <= COPIES; k++) {
          const p = k / COPIES;
          const d = len * p;
          ctx.globalAlpha = strength * Math.pow(1 - p, 0.95);
          ctx.drawImage(src, 0, y0 * dpr, src.width, BAND * dpr, d, y0 + d * slope + smear * p, src.width / dpr, BAND);
        }
      }
      // Keep the letters themselves clean: the light streams from behind them.
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'destination-out';
      ctx.drawImage(src, 0, 0, src.width / dpr, src.height / dpr);
      ctx.globalCompositeOperation = 'source-over';
      if (!reduce) requestAnimationFrame(frame);
    };

    await document.fonts.load(`400 32px "Stapelia Sans"`).catch(() => {});
    prepare();
    window.addEventListener('resize', prepare);
    requestAnimationFrame(frame);
  });
</script>
