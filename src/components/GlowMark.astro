---
// "Clear Sky" wordmark in yellow with a glowing mist trail. The trail points
// downwind using the live wind at a clear-sky spot, and scrolling smears it.
interface Props { text?: string }
const { text = 'Clear Sky' } = Astro.props;
---
<span class="glow-mark" data-glow-mark>{text}</span>

<style>
  .glow-mark {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: #fff49a;
    transition: color 0.35s var(--ease);
  }
  /* Pale yellow vanishes on the off-white pages; mustard stays readable there. */
  :global(.header:not(.is-light)) .glow-mark { color: #d9b435; }
  :global(html.theme-blue) .glow-mark, :global(html.theme-ink) .glow-mark { color: #fff49a; }
</style>

<script>
  // Clear-sky spots: Palm Springs, Punta Cana, the Namib, the Sahara, Atacama, Las Vegas.
  const spots: [number, number][] = [[33.8, -116.5], [23.7, -69.5], [-24.6, 15.1], [25.0, 25.3], [-30, -70.8], [36.1, -115.1]];
  const MIST_ALPHA = 0.45; // how strong the mist is next to the letters
  let wind = { speed: 12, dir: 270 };

  async function pickSky() {
    try {
      const cached = sessionStorage.getItem('cs-wind');
      if (cached) return (wind = JSON.parse(cached));
    } catch {}
    const lat = spots.map((s) => s[0]).join(), lon = spots.map((s) => s[1]).join();
    const r: { current: { wind_speed_10m: number; wind_direction_10m: number; weather_code: number; is_day: number } }[] = await (
      await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=wind_speed_10m,wind_direction_10m,weather_code,is_day`)
    ).json();
    const clear = r.filter((x) => x.current.weather_code === 0 && x.current.is_day);
    const pool = clear.length ? clear : r;
    const c = pool[(Math.random() * pool.length) | 0].current;
    wind = { speed: c.wind_speed_10m, dir: c.wind_direction_10m };
    try { sessionStorage.setItem('cs-wind', JSON.stringify(wind)); } catch {}
  }

  document.querySelectorAll<HTMLElement>('[data-glow-mark]').forEach((el) => {
    let scrollV = 0, lastY = window.scrollY;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function draw() {
      scrollV += (window.scrollY - lastY) * 0.3;
      lastY = window.scrollY;
      scrollV *= 0.92;
      const rad = ((wind.dir + 180) * Math.PI) / 180; // dir = where wind comes FROM
      const len = Math.min(wind.speed * 4, 140);
      const vx = Math.sin(rad) * len;
      const vy = -Math.cos(rad) * len + scrollV * 3; // scroll smears the trail
      const s: string[] = [];
      for (let i = 1; i <= 24; i++) {
        const t = i / 24;
        s.push(`${vx * t}px ${vy * t}px ${6 + t * 26}px rgba(255,240,120,${MIST_ALPHA * (1 - t)})`);
      }
      el.style.textShadow = s.join();
      if (!reduce) requestAnimationFrame(draw);
    }

    pickSky().catch(() => {}).then(draw);
  });
</script>
