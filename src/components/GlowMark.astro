---
// "Clear Sky" wordmark in yellow with a glowing mist that moves with the scroll.
interface Props { text?: string }
const { text = 'Clear Sky' } = Astro.props;
---
<span class="glow-mark" data-glow-mark>{text}</span>

<style>
  .glow-mark {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: #fff49a;
    transition: color 0.35s var(--ease);
  }
  /* Pale yellow vanishes on the off-white pages; mustard stays readable there. */
  :global(.header:not(.is-light)) .glow-mark { color: #d9b435; }
  :global(html.theme-blue) .glow-mark, :global(html.theme-ink) .glow-mark { color: #fff49a; }
</style>

<script>
  // The mist trails behind the scroll: scrolling down leaves it above the letters,
  // scrolling up leaves it below, and at rest it settles into a soft glow.
  const MIST_ALPHA = 0.45; // how strong the mist is next to the letters

  document.querySelectorAll<HTMLElement>('[data-glow-mark]').forEach((el) => {
    let scrollV = 0, lastY = window.scrollY;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function draw() {
      scrollV += (window.scrollY - lastY) * 0.3;
      lastY = window.scrollY;
      scrollV *= 0.92;
      const vy = Math.max(-140, Math.min(140, -scrollV * 3));
      const s: string[] = [];
      for (let i = 1; i <= 24; i++) {
        const t = i / 24;
        s.push(`0px ${(vy * t).toFixed(1)}px ${(6 + t * 26).toFixed(1)}px rgba(255,240,120,${(MIST_ALPHA * (1 - t)).toFixed(3)})`);
      }
      el.style.textShadow = s.join();
      if (!reduce) requestAnimationFrame(draw);
    }
    draw();
  });
</script>
