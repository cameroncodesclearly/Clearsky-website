---
// Full-screen 35mm grain over type, the sky and animation (media frames sit
// above it, see global.css). The grain is generated in the browser, never
// compressed, and drawn so each speck is about two thirds of a CSS pixel on
// any screen: fine, even, Portra-like specks with a little clumping and a
// faint colour cast.
// Strength is --grain in global.css.
---
<div class="grain" aria-hidden="true">
  <div class="grain__texture" data-grain></div>
  <div class="grain__flicker" data-grain-flicker></div>
</div>

<style>
  .grain { position: fixed; inset: 0; z-index: 900; pointer-events: none; overflow: hidden; }
  .grain__texture {
    position: absolute; inset: -320px;
    opacity: var(--grain);
    will-change: transform;
  }
  /* Exposure breathing between frames, kept to a percent or two. */
  .grain__flicker {
    position: absolute; inset: 0;
    background: #fff6ea;
    opacity: 0;
    will-change: opacity;
  }
</style>

<script>
  const tex = document.querySelector<HTMLElement>('[data-grain]');
  const flicker = document.querySelector<HTMLElement>('[data-grain-flicker]');
  if (tex && flicker) {
    // One 320px tile. Each pixel is a light or dark speck whose
    // strength follows a bell curve; a second, slightly larger noise adds the
    // clumping real silver grain has. Non power-of-two size hides the repeat.
    // Specks of 1 device pixel on standard screens, ~2/3 of a CSS pixel on
    // high-density ones (single device pixels vanish on phones).
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    const size = 320;
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = size;
    const ctx = canvas.getContext('2d')!;
    const img = ctx.createImageData(size, size);
    const gauss = () => (Math.random() + Math.random() + Math.random() + Math.random() - 2) / 0.58;
    const clump = new Float32Array(size * size).map(gauss);
    for (let i = 0; i < size * size; i++) {
      // Average each pixel's clump noise with its right and lower neighbours (wrapping).
      const x = i % size, y = (i / size) | 0;
      const c = (clump[i] + clump[y * size + ((x + 1) % size)] + clump[((y + 1) % size) * size + x]) / 3;
      const v = gauss() * 0.75 + c * 0.6;
      const light = v > 0;
      const tint = gauss() * 10;
      img.data[i * 4] = light ? 255 : 0 + tint * 0.4;
      img.data[i * 4 + 1] = light ? 250 : 0;
      img.data[i * 4 + 2] = light ? 242 + tint : 6;
      img.data[i * 4 + 3] = Math.min(255, Math.abs(v) * 120);
    }
    ctx.putImageData(img, 0, 0);
    canvas.toBlob((blob) => {
      if (!blob) return;
      tex.style.backgroundImage = `url(${URL.createObjectURL(blob)})`;
      tex.style.backgroundSize = `${size / dpr}px ${size / dpr}px`;
    });

    // New grain every frame at 24 fps by jumping the tile to a random offset.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const step = size / dpr;
      let last = 0, level = 0;
      const tick = (now: number) => {
        if (now - last >= 1000 / 24) {
          last = now;
          tex.style.transform = `translate(${(Math.random() * step).toFixed(1)}px, ${(Math.random() * step).toFixed(1)}px)`;
          level += (Math.random() * 0.025 - level) * 0.5;
          flicker.style.opacity = level.toFixed(3);
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  }
</script>
