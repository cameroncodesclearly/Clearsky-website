---
// Full-screen 35mm grain over the whole page. The tile is a Portra 400-style
// grain scan generated by scripts/make-grain.py. Strength is --grain in global.css.
---
<div class="grain" aria-hidden="true">
  <div class="grain__texture" data-grain></div>
  <div class="grain__flicker" data-grain-flicker></div>
</div>

<style>
  .grain { position: fixed; inset: 0; z-index: 900; pointer-events: none; overflow: hidden; }
  .grain__texture {
    position: absolute; inset: -256px;
    background: url('/sky/grain.webp') 0 0 / 256px 256px repeat;
    opacity: var(--grain);
    mix-blend-mode: overlay;
  }
  /* Exposure breathing between frames, kept to a percent or two. */
  .grain__flicker {
    position: absolute; inset: 0;
    background: #fff6ea;
    opacity: 0;
    mix-blend-mode: soft-light;
  }
</style>

<script>
  // New grain every frame at 24 fps by jumping the tile to a random offset.
  const tex = document.querySelector<HTMLElement>('[data-grain]');
  const flicker = document.querySelector<HTMLElement>('[data-grain-flicker]');
  if (tex && flicker && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let last = 0, level = 0;
    const tick = (now: number) => {
      if (now - last >= 1000 / 24) {
        last = now;
        tex.style.transform = `translate(${Math.floor(Math.random() * 256)}px, ${Math.floor(Math.random() * 256)}px)`;
        level += (Math.random() * 0.05 - level) * 0.5;
        flicker.style.opacity = level.toFixed(3);
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
