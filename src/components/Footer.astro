---
import { site } from '../lib/site';

interface Props { theme?: string }
const { theme = 'blue' } = Astro.props;
const year = new Date().getFullYear();
---
<footer class={`footer theme-${theme}`} data-header-light={theme === 'blue' || theme === 'ink' ? '' : undefined}>
  <section class="footer__cta">
    <div class="footer__doodle" data-doodle="/lottie/sky.json" aria-hidden="true"></div>
    <h2 class="footer__line">
      It's <span class="clock" data-clock>9:41 AM</span>.<br />
      Perfect weather to start something.
    </h2>
    <a class="pill pill--solid" href="/contact/">Let's talk</a>
  </section>

  <div class="footer__bar">
    <p class="ui">&copy; {site.name} {year}</p>
    <ul class="footer__links">
      {site.socials.map((s) => <li><a class="ui" href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>)}
      <li><a class="ui" href="/journal/">Journal</a></li>
      <li><a class="ui" href={`mailto:${site.email}`}>Email us</a></li>
    </ul>
  </div>
  <a href="/" class="footer__wordmark" aria-label={`${site.name} home`}>Clear Sky</a>
</footer>

<style>
  .footer { position: relative; overflow: hidden; }
  .footer__cta {
    min-height: min(100svh, 980px);
    display: grid; place-content: center; justify-items: center; gap: 2rem;
    padding: clamp(6rem, 12vw, 10rem) var(--gutter) 4rem; text-align: center;
  }
  .footer__doodle { width: min(62vw, 320px); aspect-ratio: 600 / 460; margin-bottom: -1rem; }
  .footer__line {
    font-family: var(--font-display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 4.2rem); line-height: 0.98; max-width: 16ch;
  }
  .clock {
    display: inline-block; padding: 0.02em 0.32em 0; border: 0.07em solid currentColor; border-radius: 999px;
    font-variant-numeric: tabular-nums; line-height: 1; vertical-align: 0.04em; font-size: 0.82em;
  }
  .footer__bar {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem 1.5rem;
    padding: 0 var(--gutter) 0.6rem;
  }
  .footer__links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 1.5rem; }
  .footer__links a:hover { color: var(--accent); }
  .footer__wordmark {
    display: block; text-align: center; white-space: nowrap;
    font-family: var(--font-display); text-transform: uppercase;
    font-size: 19.6vw; line-height: 0.8; letter-spacing: -0.01em;
    margin-bottom: -0.06em; padding-top: 0.05em;
  }
  @media (max-width: 599px) {
    .footer__bar { flex-direction: column; align-items: center; text-align: center; }
    .footer__links { justify-content: center; }
  }
</style>
