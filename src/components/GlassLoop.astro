---
// The glass "Clear Sky" loop (sun, camera, lightbulb, heart) on the loading
// screen. Shows a still first; src/scripts/site.ts swaps in the moving version.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<div class:list={['glass-loop', className]} data-glass aria-hidden="true">
  <img src="/glass/poster-480.webp" alt="" width="480" height="480" decoding="async" />
</div>

<style>
  .glass-loop { aspect-ratio: 1; display: grid; }
  .glass-loop > :global(img), .glass-loop > :global(video) {
    grid-area: 1 / 1; width: 100%; height: 100%; object-fit: contain;
  }
</style>
