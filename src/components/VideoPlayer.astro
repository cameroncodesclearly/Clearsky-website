---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseVideo, playerEmbed, backgroundEmbed, posterFor, watchUrl } from '../lib/site';

// A muted preview loops while in view, with no play button over it. The whole
// frame is clickable and loads the full player with sound; a small muted-speaker
// badge in the corner says sound is there.
interface Props {
  video?: string | null;
  poster?: ImageMetadata | null;
  title?: string;
  vertical?: boolean;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { video, poster, title = 'Video', vertical, class: className, sizes = '100vw', eager = false } = Astro.props;
const ref = parseVideo(video);
const still = poster ?? posterFor(ref);
const isVertical = vertical ?? (still ? still.height > still.width : false);
const watch = ref ? watchUrl(ref) : undefined;
const watchLabel = ref?.provider === 'instagram' ? 'Instagram' : ref?.provider === 'youtube' ? 'YouTube' : 'Vimeo';
---
<div
  class:list={['frame player', isVertical ? 'ratio-9x16 is-vertical' : 'ratio-16x9', className]}
  data-embed={ref ? backgroundEmbed(ref) : undefined}
  data-player={ref ? playerEmbed(ref) : undefined}
  data-watch={watch}
  data-watch-label={watchLabel}
>
  {still && <Image src={still} alt="" widths={[640, 1080, 1600, 2000]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />}
  {ref && (
    <button class="player__play" type="button" data-cursor="Play with sound" aria-label={`Play ${title}`}>
      <span class="player__sound" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </span>
    </button>
  )}
</div>

<style>
  .player__play { position: absolute; inset: 0; z-index: 2; width: 100%; cursor: pointer; }
  .player__sound {
    position: absolute; right: 0.8rem; bottom: 0.8rem; display: grid; place-items: center;
    width: 2.1rem; height: 2.1rem; border-radius: 50%;
    color: var(--paper); background: rgba(20, 16, 10, 0.45); backdrop-filter: blur(6px);
    transition: background-color 0.3s, scale 0.3s var(--ease);
  }
  .player__sound svg { width: 1.1rem; height: 1.1rem; fill: currentColor; }
  .player__play:hover .player__sound { background: rgba(20, 16, 10, 0.7); scale: 1.08; }
  .player__play:focus-visible { outline: 3px solid var(--butter); outline-offset: -3px; }
  :global(.player.is-open) .player__play { display: none; }
  :global(.player.is-open > iframe) { pointer-events: auto; opacity: 1; background: var(--ink); }
  :global(.player__fallback) { position: absolute; inset: auto 0 1rem; z-index: 3; display: flex; justify-content: center; }
</style>

<script>
  import { onReady, fitToFrame } from '../scripts/player';
  import { track } from '../scripts/analytics';
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((frame) => {
    const button = frame.querySelector('.player__play');
    button?.addEventListener('click', () => {
      track('video_played', { title: button.getAttribute('aria-label')?.replace(/^Play /, ''), page: location.pathname });
      frame.querySelectorAll('iframe').forEach((f) => f.remove());
      // Keep the frame from loading its muted preview again.
      delete frame.dataset.embed;
      const iframe = document.createElement('iframe');
      iframe.src = frame.dataset.player!;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = button.getAttribute('aria-label') || 'Video';
      frame.append(iframe);
      fitToFrame(iframe, frame);
      frame.classList.add('is-open');
      onReady(iframe, () => {}, () => {
        iframe.remove();
        frame.classList.remove('is-open');
        const link = document.createElement('div');
        link.className = 'player__fallback';
        link.innerHTML = `<a class="pill pill--solid" href="${frame.dataset.watch}" target="_blank" rel="noopener">Watch on ${frame.dataset.watchLabel}</a>`;
        frame.append(link);
      });
    });
  });
</script>
