---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { parseVideo, playerEmbed, backgroundEmbed, posterFor } from '../lib/site';

// Poster with a play button. A muted preview loops behind it while in view;
// clicking loads the full player with sound.
interface Props {
  video?: string | null;
  poster?: ImageMetadata | null;
  title?: string;
  vertical?: boolean;
  class?: string;
  sizes?: string;
  eager?: boolean;
}
const { video, poster, title = 'Video', vertical, class: className, sizes = '100vw', eager = false } = Astro.props;
const ref = parseVideo(video);
const still = poster ?? posterFor(ref);
const isVertical = vertical ?? (still ? still.height > still.width : false);
const watchUrl = ref ? (ref.provider === 'vimeo' ? `https://vimeo.com/${ref.id}${ref.hash ? `/${ref.hash}` : ''}` : `https://www.youtube.com/watch?v=${ref.id}`) : undefined;
---
<div
  class:list={['frame player', isVertical ? 'ratio-9x16 is-vertical' : 'ratio-16x9', className]}
  data-embed={ref ? backgroundEmbed(ref) : undefined}
  data-player={ref ? `${playerEmbed(ref)}&autoplay=1` : undefined}
  data-watch={watchUrl}
>
  {still && <Image src={still} alt="" widths={[640, 1080, 1600, 2000]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />}
  {ref && (
    <button class="player__play" type="button" data-cursor="Play with sound" aria-label={`Play ${title}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
    </button>
  )}
</div>

<style>
  .player__play {
    position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; width: 100%;
  }
  .player__play svg {
    width: clamp(56px, 7vw, 88px); height: auto; padding: 1.1rem 1rem 1.1rem 1.25rem; border-radius: 50%;
    fill: var(--ink); background: var(--paper); transition: scale 0.4s var(--ease), background-color 0.3s;
  }
  .player__play:hover svg { scale: 1.08; background: var(--butter); }
  :global(.player.is-open) .player__play { display: none; }
  :global(.player.is-open > iframe) { pointer-events: auto; opacity: 1; width: 100%; height: 100%; translate: none; top: 0; left: 0; }
  :global(.player__fallback) { position: absolute; inset: auto 0 1rem; z-index: 3; display: flex; justify-content: center; }
</style>

<script>
  import { onReady } from '../scripts/player';
  document.querySelectorAll<HTMLElement>('[data-player]').forEach((frame) => {
    const button = frame.querySelector('.player__play');
    button?.addEventListener('click', () => {
      frame.querySelectorAll('iframe').forEach((f) => f.remove());
      // Keep the frame from loading its muted preview again.
      delete frame.dataset.embed;
      const iframe = document.createElement('iframe');
      iframe.src = frame.dataset.player!;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = button.getAttribute('aria-label') || 'Video';
      frame.append(iframe);
      frame.classList.add('is-open');
      onReady(iframe, () => {}, () => {
        iframe.remove();
        frame.classList.remove('is-open');
        const link = document.createElement('div');
        link.className = 'player__fallback';
        link.innerHTML = `<a class="pill pill--solid" href="${frame.dataset.watch}" target="_blank" rel="noopener">Watch on Vimeo</a>`;
        frame.append(link);
      });
    });
  });
</script>
