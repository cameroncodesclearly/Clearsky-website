---
import SunRise from './SunRise.astro';

// Homepage headline section that replaces cm.studio's "second brain". The
// headline scrolls in and locks in the middle of the screen; while it is held,
// the live weather clears (weather.ts) and the sun rises behind it, then the
// page carries on.
interface Props { heading: string }
const { heading } = Astro.props;
---
<section class="breeze" aria-labelledby="breeze-heading">
  <div class="breeze__rise" data-rise>
    <div class="breeze__stage">
      <SunRise />
      <h2 class="mega breeze__heading" id="breeze-heading" data-reveal>{heading}</h2>
    </div>
  </div>
  <!-- Outside the sticky stage on purpose: the stage is its own layer, and a
       screen blend inside it would have nothing (no sky) to blend with. -->
  <canvas class="breeze__leak" width="480" height="270" aria-hidden="true" data-leak></canvas>
</section>

<style>
  /* clip, not hidden: hidden would make this a scroll box and break both the
     sticky stage and the scroll timeline. */
  .breeze { text-align: center; padding-inline: var(--gutter); overflow: clip; }
  /* The tall box sets how long the headline stays locked: everything past one
     screen of height is pinned time. It names the scroll timeline the sun runs on. */
  .breeze__rise { height: 260vh; view-timeline: --rise block; }
  @media (max-width: 699px) { .breeze__rise { height: 210vh; } }
  .breeze__stage {
    position: sticky; top: 0; height: 100vh; height: 100svh;
    display: grid; align-content: end; justify-items: center;
    padding-bottom: 7vh;
  }
  .breeze__heading { max-width: 12ch; position: relative; z-index: 1; }
  /* Light type while a night or storm sky is still clearing behind it (--wx
     is set on the headline by weather.ts). */
  :global(html.sky-dark) .breeze__heading { color: color-mix(in srgb, var(--paper) calc(var(--wx, 0) * 100%), var(--ink)); }


  /* A real light leak washes over the page as the sun passes behind the
     headline and climbs, scrubbed by scroll (frame by frame from a 30-frame sheet).
     Screen blending drops the black, leaving only the light. Hidden outside
     its stretch so the blend costs nothing the rest of the time. */
  .breeze__leak {
    position: fixed; inset: 0; z-index: 899; width: 100%; height: 100%;
    pointer-events: none; mix-blend-mode: screen; opacity: 0.85;
    visibility: hidden;
  }
  .breeze__leak.is-on { visibility: visible; }
</style>

<script>
  // Light leak: from 22% to 90% of the locked stretch (from the moment the sun
  // first shows behind the headline until it is all the way up) the frames
  // play forward with the scroll,
  // and backward when scrolling up. Neighbouring frames are cross-faded so
  // it moves smoothly between the 30 frames.
  const rise = document.querySelector<HTMLElement>('[data-rise]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-leak]');
  if (rise && canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const FRAMES = 30, COLS = 6, W = 480, H = 270;
    const ctx = canvas.getContext('2d')!;
    const sheet = new Image();
    let ready = false, queued = false, lastT = -1;
    sheet.onload = () => { ready = true; draw(); };
    const draw = () => {
      queued = false;
      const r = rise.getBoundingClientRect();
      const q = -r.top / Math.max(1, r.height - window.innerHeight);
      if (!sheet.src && q > -0.6) sheet.src = '/sky/light-leak-frames.jpg'; // load just before it's needed
      const t = (q - 0.22) / 0.68;
      const on = ready && t > 0 && t < 1;
      canvas.classList.toggle('is-on', on);
      if (!on || Math.abs(t - lastT) < 0.002) return;
      lastT = t;
      const f = t * (FRAMES - 1), i = Math.floor(f), mix = f - i;
      const blit = (n: number, alpha: number) => {
        ctx.globalAlpha = alpha;
        ctx.drawImage(sheet, (n % COLS) * W, Math.floor(n / COLS) * H, W, H, 0, 0, W, H);
      };
      ctx.globalAlpha = 1;
      blit(i, 1);
      if (i + 1 < FRAMES && mix > 0) blit(i + 1, mix);
    };
    window.addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(draw); } }, { passive: true });
    draw();
  }
</script>
