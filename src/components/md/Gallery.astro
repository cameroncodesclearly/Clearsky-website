---
// Two or more images in a row on a Notion page, shown side by side and wider
// than the text column.
---
<div class="md-gallery md-wide"><slot /></div>

<style>
  .md-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 1rem; margin-block: 3rem; }
</style>
