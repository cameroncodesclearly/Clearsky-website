---
// An image from a Notion page. Its caption doubles as alt text.
import { Image } from 'astro:assets';
import { resolveImage } from '../../lib/site';
interface Props { src: string; alt?: string }
const { src, alt = '' } = Astro.props;
const img = resolveImage(src);
---
{img && (
  <figure class="md-figure frame" data-reveal>
    <Image src={img} alt={alt} widths={[640, 1080, 1600, 2000]} sizes="(min-width: 1440px) 1200px, 100vw" />
    {alt && <figcaption class="ui ui-muted">{alt}</figcaption>}
  </figure>
)}

<style>
  .md-figure { position: relative; margin-block: 2.5rem; background: none; overflow: visible; }
  .md-figure :global(img) { width: 100%; height: auto; border-radius: var(--radius); margin: 0; }
  .md-figure figcaption { margin-top: 0.6rem; text-align: center; }
  /* Inside a gallery the cells set the size. */
  :global(.md-gallery) .md-figure { margin: 0; }
  :global(.md-gallery) .md-figure :global(img) { aspect-ratio: 4 / 5; object-fit: cover; }
  :global(.md-gallery) figcaption { display: none; }
</style>
