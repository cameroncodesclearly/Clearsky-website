---
import type { CollectionEntry } from 'astro:content';
import VideoFrame from './VideoFrame.astro';
import { parseVideo, posterFor } from '../lib/site';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  ratio?: '16x9' | '16x10' | '9x16' | '4x5';
  /** Use the vertical hero video's poster when the card is portrait. */
  portrait?: boolean;
  sizes?: string;
  class?: string;
}
const { entry, ratio = '16x10', portrait = false, sizes, class: className } = Astro.props;
const d = entry.data;
const heroPoster = posterFor(parseVideo(d.videoUrl));
const poster = portrait && heroPoster && heroPoster.height > heroPoster.width ? heroPoster : d.cover;
---
<a class:list={['work-card', className]} href={`/work/${entry.id}/`}>
  <span class="caption">
    <span class="ui">{d.client}</span>
    <span class="ui ui-muted">{d.title}</span>
  </span>
  <span class="work-card__media">
    <VideoFrame video={d.videoUrl} poster={poster} alt={`${d.client}: ${d.title}`} ratio={portrait ? '9x16' : ratio} cursor={d.status === 'building' ? 'Coming soon' : 'See the work'} sizes={sizes} />
    {d.status === 'building' && (
      <span class="work-card__soon" aria-hidden="true"><span class="display">{d.client}</span><span class="ui">Coming soon</span></span>
    )}
  </span>
</a>

<style>
  .work-card__media { position: relative; display: block; }
  /* Placeholder studies: the client's name on the sky, until the story is in. */
  .work-card__soon {
    position: absolute; inset: 0; z-index: 951; display: grid; place-content: center; justify-items: center; gap: 0.4rem;
    padding: 1rem; text-align: center; color: var(--ink); pointer-events: none;
  }
  .work-card__soon .display { font-size: clamp(1.3rem, 0.8rem + 1.6vw, 2.4rem); line-height: 0.95; }

  .work-card { display: block; }
  .work-card :global(.frame img) { transition: transform 1.2s var(--ease); }
  .work-card:hover :global(.frame img) { transform: scale(1.04); }
</style>
