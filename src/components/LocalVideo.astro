---
// A self-hosted video (like the homepage sizzle) that behaves like the site's
// Vimeo players: a muted loop while on screen, with no play button over it;
// clicking anywhere plays it from the start with sound and the browser's
// controls. A smaller file is used on phones.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: string; small?: string; poster: ImageMetadata; title: string; class?: string; sizes?: string }
const { src, small, poster, title, class: className, sizes = '100vw' } = Astro.props;
---
<div class:list={['frame ratio-16x9 local-video', className]} data-local-video data-src={src} data-small={small ?? src}>
  <Image src={poster} alt="" widths={[800, 1280, 1920]} sizes={sizes} />
  <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
  <button class="local-video__play" type="button" data-cursor="Play with sound" aria-label={`Play ${title} with sound`}>
    <span class="local-video__sound" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" /><path d="M16 9.5l5 5M21 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </span>
  </button>
</div>

<style>
  .local-video video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s ease; }
  .local-video.is-playing video, .local-video.is-open video { opacity: 1; }
  .local-video.is-open video { object-fit: contain; background: var(--ink); }
  .local-video__play { position: absolute; inset: 0; z-index: 2; width: 100%; cursor: pointer; }
  .local-video.is-open .local-video__play { display: none; }
  .local-video__sound {
    position: absolute; right: 0.8rem; bottom: 0.8rem; display: grid; place-items: center;
    width: 2.1rem; height: 2.1rem; border-radius: 50%;
    color: var(--paper); background: rgba(20, 16, 10, 0.45); backdrop-filter: blur(6px);
  }
  .local-video__sound svg { width: 1.1rem; height: 1.1rem; fill: currentColor; }
  .local-video__play:focus-visible { outline: 3px solid var(--butter); outline-offset: -3px; }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-local-video]').forEach((el) => {
    const video = el.querySelector('video')!;
    const load = () => {
      if (!video.src) video.src = window.innerWidth < 900 ? el.dataset.small! : el.dataset.src!;
    };
    video.addEventListener('playing', () => el.classList.add('is-playing'));
    if (!reduce) {
      new IntersectionObserver(([e]) => {
        if (el.classList.contains('is-open')) return; // theirs now
        if (e.isIntersecting) { load(); video.play().catch(() => {}); } else video.pause();
      }, { rootMargin: '25% 0px' }).observe(el);
    }
    el.querySelector('button')!.addEventListener('click', () => {
      el.classList.add('is-open');
      // Full quality with sound, from the start.
      video.src = el.dataset.src!;
      video.muted = false;
      video.loop = false;
      video.controls = true;
      video.removeAttribute('aria-hidden');
      video.removeAttribute('tabindex');
      video.currentTime = 0;
      video.play().catch(() => {});
    });
  });
</script>
