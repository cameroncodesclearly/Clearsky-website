---
import GlowMark from './GlowMark.astro';
import { nav, site, publishedServices } from '../lib/site';

const services = await publishedServices();
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---
<header class="header" data-header>
  <a class="header__logo" href="/" aria-label={`${site.name} home`}>
    <GlowMark />
  </a>

  <nav class="header__nav" aria-label="Main">
    {nav.map((item) =>
      item.submenu ? (
        <div class="header__item header__item--sub">
          <button class="ui header__link" type="button" aria-expanded="false" aria-controls="services-menu" data-submenu-toggle>
            {item.label}
          </button>
          <ul class="header__submenu" id="services-menu" data-submenu>
            {services.map((s) => (
              <li><a class="ui" href={`/services/${s.id}/`}>{s.data.title}</a></li>
            ))}
            <li><a class="ui ui-muted" href="/services/">All services</a></li>
          </ul>
        </div>
      ) : (
        <a class:list={['ui header__link header__item', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ),
    )}
  </nav>

  <button class="ui header__menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
    <span class="open-label">Menu</span><span class="close-label">Close</span>
  </button>

  <div class="mobile-menu theme-blue" id="mobile-menu">
    <ul class="mobile-menu__main">
      <li><a href="/work/">Work</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="/services/">Services</a></li>
      <li><a href="/journal/">Journal</a></li>
      <li><a href="/contact/">Contact</a></li>
    </ul>
    <ul class="mobile-menu__services">
      {services.map((s) => <li><a class="ui" href={`/services/${s.id}/`}>{s.data.title}</a></li>)}
    </ul>
    <ul class="mobile-menu__social">
      {site.socials.map((s) => <li><a class="ui" href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>)}
    </ul>
  </div>
</header>

<style>
  .header {
    position: fixed; inset: 0 0 auto; z-index: 100;
    height: var(--header-h);
    display: grid; grid-template-columns: 1fr auto; align-items: center;
    padding-inline: var(--gutter);
    color: var(--fg);
    transition: color 0.35s var(--ease);
  }
  .header.is-light:not(.menu-open):not(.submenu-open) { color: var(--paper); }
  .header::before {
    /* Soft paper wash so the nav stays readable over content while scrolling. */
    content: ''; position: absolute; inset: 0 0 -24px; z-index: -1; pointer-events: none;
    background: linear-gradient(var(--bg) 40%, transparent);
    opacity: 0.92; transition: opacity 0.35s var(--ease);
  }
  .header.is-light::before { opacity: 0; }
  .header__logo { display: block; justify-self: start; padding-block: 0.4rem; }
  .header__nav { display: none; }
  .header__menu-btn { justify-self: end; padding: 0.6rem 0; }
  .header__menu-btn .close-label, .menu-open .header__menu-btn .open-label { display: none; }
  .menu-open .header__menu-btn .close-label { display: inline; }
  .menu-open { color: var(--paper); }
  .menu-open::before { opacity: 0; }

  .mobile-menu {
    position: fixed; inset: 0; z-index: -1;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 2rem;
    display: grid; align-content: space-between; gap: 2rem;
    opacity: 0; visibility: hidden; transition: opacity 0.4s var(--ease), visibility 0.4s;
    overflow-y: auto;
  }
  .menu-open .mobile-menu { opacity: 1; visibility: visible; }
  .mobile-menu ul { list-style: none; margin: 0; padding: 0; }
  .mobile-menu__main a { font-family: var(--font-display); font-size: clamp(3rem, 16vw, 6rem); line-height: 0.95; text-transform: uppercase; display: block; }
  .mobile-menu__services, .mobile-menu__social { display: flex; flex-wrap: wrap; gap: 0.6rem 1.2rem; }

  @media (min-width: 900px) {
    .header { grid-template-columns: 1fr 2fr; }
    .header__menu-btn, .mobile-menu { display: none; }
    .header__nav { display: grid; grid-template-columns: repeat(4, 1fr); align-items: start; }
    .header__item { position: relative; }
    .header__link { display: inline-block; padding-block: 0.6rem; position: relative; }
    .header__link::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 0.35rem; height: 2px; background: currentColor;
      transform: scaleX(0); transform-origin: left; transition: transform 0.45s var(--ease);
    }
    .header__link:hover::after, .header__link.is-active::after, [aria-expanded='true'].header__link::after { transform: scaleX(1); }
    .header__submenu {
      list-style: none; margin: 0; padding: 0.4rem 0 0; position: absolute; top: 100%; left: 0;
      display: grid; gap: 0.35rem; white-space: nowrap;
      opacity: 0; visibility: hidden; translate: 0 -6px;
      transition: opacity 0.3s var(--ease), translate 0.4s var(--ease), visibility 0.3s;
    }
    .submenu-open .header__submenu { opacity: 1; visibility: visible; translate: 0 0; }
    .header__submenu a:hover { color: var(--blue); }
  }
</style>
